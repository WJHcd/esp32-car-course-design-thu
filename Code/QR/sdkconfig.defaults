#
# SPIRAM (WROOM-2 自带 PSRAM，必须启用，UVC 帧缓冲 / TFT 帧缓冲依赖)
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=150000
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

#
# USB Host（摄像头 UVC 使用）
#
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=3000
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y

#
# CPU
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

#
# Flash（WROOM-2 默认 16MB；若模组为 32MB 改 CONFIG_ESPTOOLPY_FLASHSIZE_32MB）
#
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
