    <title>Espressif Centralized Documentation Platform (CDP)</title>
    <script>
      // 在页面加载的最开始就检查，如果不是首次加载，通过 CSS 直接隐藏加载动画
      // 这个脚本必须在 head 中尽早执行，在 body 渲染前就生效
      (function() {
        try {
          const FIRST_LOAD_KEY = '__app_first_load_completed__'
          if (sessionStorage.getItem(FIRST_LOAD_KEY)) {
            // 非首次加载，立即通过内联样式隐藏加载动画
            const style = document.createElement('style')
            style.id = 'hide-loading-style'
            style.textContent = '.app-loading { display: none !important; visibility: hidden !important; opacity: 0 !important; }'
            document.head.appendChild(style)
          }
        } catch (e) {
          console.error('Error hiding loading animation:', e)
        }
      })()
    </script>
    <!-- CDN CSS 优先加载（在 head 最前面，确保最先加载） -->
