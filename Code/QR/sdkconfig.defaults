#
# SPIRAM (WROOM-2 自带 PSRAM，必须启用，UVC 帧缓冲 / TFT 帧缓冲依赖)
# ⚠️ WROOM-2 的 PSRAM 为八线（AP_1v8），必须 OCTAL 模式；QUAD 会在启动时报
#    "PSRAM chip is not connected, or wrong PSRAM line mode" 并反复重启。
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=150000
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

#
# USB Host（摄像头 UVC 使用；参数对齐 task2-camera-line 实测值）
#
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=250
CONFIG_USB_HOST_RESET_HOLD_MS=30
CONFIG_USB_HOST_RESET_RECOVERY_MS=30
CONFIG_USB_HOST_SET_ADDR_RECOVERY_MS=10
CONFIG_UVC_INTERVAL_ARRAY_SIZE=3
CONFIG_UVC_CHECK_PAYLOAD_HEADER_EOH=y
CONFIG_UVC_CHECK_PAYLOAD_HEADER_ERR=y

#
# CPU
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

#
# Flash（WROOM-2 默认 16MB；若模组为 32MB 改 CONFIG_ESPTOOLPY_FLASHSIZE_32MB）
#
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
