#
# SPIRAM（ESP32-S3 WROOM 模组带 PSRAM，语音识别内存较大，必须启用）
# ⚠️ 实车模组为 Octal PSRAM（同 task2-camera-line）；若板子为 Quad
#    模组（如 camera-task 的配置）改回 CONFIG_SPIRAM_MODE_QUAD=y
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=150000
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

#
# CPU（语音识别 + AFE 运算量较大，跑满 240MHz）
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

#
# Flash（WROOM-2 默认 16MB；若模组为 32MB 改 CONFIG_ESPTOOLPY_FLASHSIZE_32MB）
#
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

#
# 分区表：自定义（新增 model 分区存放 ESP-SR 语音模型）
# ⚠️ 修改后需删除 build/ 下的 sdkconfig 重新配置（idf.py fullclean）
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

#
# ESP-SR 语音模型（离线）
#   - 唤醒词：Hi,乐鑫 (wn9_hilexin)
#   - 中文命令词：MultiNet7 (mn7_cn) —— 前进/倒退/左转/右转/调头/停止
# ⚠️ 修改模型后需 fullclean 重新生成 srmodels.bin
#
CONFIG_SR_WN_WN9_HILEXIN=y
CONFIG_SR_MN_CN_MULTINET7_QUANT=y

#
# USB Host：摄像头(UVC+UAC)配置描述符实测 16330 字节，控制传输缓冲
# 必须能一次装下（4096 不够，会导致等时管道建立失败、麦克风全零流）
#
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=16384

#
# BLE 蓝牙遥控（NimBLE 主机，外设角色，最多 1 连接）
# ⚠️ 与 ESP-SR 同固件共存；如 RAM 紧张可再裁剪 NimBLE
#
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_FREERTOS_HZ=1000

#
# 任务看门狗：quirc 整帧洪水填充可能超 5s（复杂背景病态耗时），
# 已用中央裁剪窗限制大部分场景；这里不再把 CPU0 空闲任务挂到看门狗，
# 避免周期性告警刷屏（真挂死靠复位恢复，演示场景可接受）。
#
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
